# Copy this file's values into real environment variables (or backend/src/main/resources/application-local.yml)
# to run the backend. Never commit real secrets.

# --- MySQL ---
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# --- Snowflake (only needed when snowflake.enabled=true) ---
SNOWFLAKE_USER=your_snowflake_user
SNOWFLAKE_PASSWORD=your_snowflake_password
